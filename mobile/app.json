{
  "expo": {
    "name": "Unravel",
    "slug": "unravel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amosyang.unravel",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.unravel.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#f7f5f2",
          "dark": {
            "backgroundColor": "#161413",
            "image": "./assets/splash-icon-dark.png"
          },
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Unravel uses your microphone when you tap Record. Saving uploads the recording to your private journal account.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#bd927f",
          "defaultChannel": "reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-sharing",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Blush",
            "ios": "./assets/icons/blush.png",
            "android": {
              "foregroundImage": "./assets/icons/blush-android.png",
              "backgroundColor": "#faeff2"
            }
          },
          {
            "name": "Mist",
            "ios": "./assets/icons/mist.png",
            "android": {
              "foregroundImage": "./assets/icons/mist-android.png",
              "backgroundColor": "#ebf3f9"
            }
          },
          {
            "name": "Lilac",
            "ios": "./assets/icons/lilac.png",
            "android": {
              "foregroundImage": "./assets/icons/lilac-android.png",
              "backgroundColor": "#f5f0f9"
            }
          },
          {
            "name": "Sage",
            "ios": "./assets/icons/sage.png",
            "android": {
              "foregroundImage": "./assets/icons/sage-android.png",
              "backgroundColor": "#eef7f1"
            }
          },
          {
            "name": "Dusk",
            "ios": "./assets/icons/dusk.png",
            "android": {
              "foregroundImage": "./assets/icons/dusk-android.png",
              "backgroundColor": "#181721"
            }
          },
          {
            "name": "Ink",
            "ios": "./assets/icons/ink.png",
            "android": {
              "foregroundImage": "./assets/icons/ink-android.png",
              "backgroundColor": "#161413"
            }
          }
        ]
      ]
    ],
    "scheme": "unravel",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24e6c786-7d6d-4657-b639-dd8990224354"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/24e6c786-7d6d-4657-b639-dd8990224354"
    }
  }
}
