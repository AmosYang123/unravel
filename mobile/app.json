{
  "expo": {
    "name": "Unravel",
    "slug": "unravel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unravel.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Unravel uses your microphone when you tap Record. Saving uploads the recording to your private journal account."
      }
    },
    "android": {
      "package": "com.unravel.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#f7f5f2"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Unravel uses your microphone when you tap Record. Saving uploads the recording to your private journal account.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#bd927f",
          "defaultChannel": "reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-sharing"
    ],
    "scheme": "unravel",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24e6c786-7d6d-4657-b639-dd8990224354"
      }
    }
  }
}
